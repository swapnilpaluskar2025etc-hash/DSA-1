#include <stdio.h>
#include <string.h>

/* Function declarations */
int palindrome(char name[]);
void copy(char input[], char output[]);
void substring(char name[]);

int main()
{
    char name[100];
    char output[100];
    int choice;

    printf("\n===== STRING OPERATIONS =====\n");
    printf("1. Check Palindrome\n");
    printf("2. Copy String\n");
    printf("3. Substring and String Length\n");
    printf("4. Exit\n");

    printf("\nEnter your choice: ");
    scanf("%d", &choice);

    switch(choice)
    {
        case 1:
            printf("\nEnter a string: ");
            scanf("%s", name);

 if (palindrome(name))
                printf("Palindrome\n");
            else
                printf("Not a palindrome\n");

            break;

        case 2:
            printf("\nEnter a string: ");
            scanf("%s", name);

            copy(name, output);

            printf("Copied string: %s\n", output);

            break;

        case 3:
            printf("\nEnter a string: ");
            scanf("%s", name);

            printf("String length: %lu\n", strlen(name));

            substring(name);

            break;

        case 4:
            printf("\nExiting program...\n");
            break;

        default:
            printf("\nInvalid choice!\n");
    }

    return 0;
}


/* Function to check palindrome */
int palindrome(char name[])
{
    int i = 0, j = 0;

    while (name[j] != '\0')
        j++;

    j--;

    while (i < j)
    {
        if (name[i] != name[j])
            return 0;

        i++;
        j--;
    }

    return 1;
}


/* Function to copy string */
void copy(char input[], char output[])
{
    int i;

    for (i = 0; input[i] != '\0'; i++)
    {
        output[i] = input[i];
    }

    output[i] = '\0';
}


/* Function to find substring */
void substring(char name[])
{
    int n, i, p;
    char output[100];

    printf("Enter starting position: ");
    scanf("%d", &p);

    n = strlen(name);

    if (p < n && p >= 0)
    {
        for (i = 0; p + i < n; i++)
        {
            output[i] = name[p + i];
        }

        output[i] = '\0';

        printf("Substring: %s\n", output);
    }
    else
    {
        printf("Invalid position\n");
    }
}
