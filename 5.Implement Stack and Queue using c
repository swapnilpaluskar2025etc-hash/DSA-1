#include <stdio.h>
#define SIZE 5

int main()
{
    int stack[SIZE], top = -1;
    int choice, value, i;

    do
    {
        printf("\n1.Push\n2.Pop\n3.Display\n4.Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                if(top == SIZE - 1)
                    printf("Stack Overflow");
                else
                {
                    printf("Enter value: ");
                    scanf("%d", &value);
                    top++;
                    stack[top] = value;
                }
                break;

            case 2:
                if(top == -1)
                    printf("Stack Underflow");
                else
                {
                    printf("Deleted: %d", stack[top]);
                    top--;
                }
                break;

            case 3:
                if(top == -1)
                    printf("Stack is empty");
                else
                {
                    for(i = top; i >= 0; i--)
                        printf("%d ", stack[i]);
                }
                break;

            case 4:
                printf("Exiting...");
                break;

            default:
                printf("Invalid choice");
        }

    } while(choice != 4);

    return 0;
}
